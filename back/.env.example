

# Massive.com API key (formerly Polygon.io)
# Get yours at https://polygon.io/
MASSIVE_KEY=your_key_here

# Optional: alternate names also accepted by the loader
# MASSIVE_API_KEY=your_key_here
# POLYGON_API_KEY=your_key_here

# eToro Public API keys (generate in eToro → Settings → Trading → Create New Key).
# Used by the /etoro router as a dev fallback when a tenant has no vault row.
ETORO_PUBLIC_KEY=
ETORO_PRIVATE_KEY=

# Supabase local stack (from `npx supabase start`). Use the JWT-format
# service_role key (eyJ...), NOT the sb_secret_... form — supabase-py rejects the latter.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Fernet key for the eToro credential vault: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QUANTIQ_ENC_KEY=
# Set to true to allow real-money eToro execution endpoints (default: demo only)
QUANTIQ_ALLOW_REAL_EXECUTION=false
